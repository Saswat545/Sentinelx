# SentinelX — Environment Variables
# Copy this file to .env and fill in the values.

# Backend API URL (required for contract analysis)
VITE_API_URL=

# Supabase (optional — required for authentication)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo mode — set to "true" to enable demo analysis results
VITE_DEMO_MODE=false

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=
