# SentinelX Environment Variables

# Backend API URL (production: https://api.sentinelx.site)
VITE_API_URL=

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Leave empty to disable analytics
VITE_GA_MEASUREMENT_ID=

# Demo mode toggle (set to true only for development/testing)
VITE_DEMO_MODE=false

# Server-side only (do NOT prefix with VITE_)
# Gemini API Key for AI audit insights
GEMINI_API_KEY=

# Server port
PORT=3000
