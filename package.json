{
  "name": "rugguard-ml",
  "version": "2.0.0",
  "private": true,
  "description": "SentinelX - AI-Powered Machine Learning Smart Contract Security & Risk Intelligence Platform",
  "scripts": {
    "backend": "python -m uvicorn backend.main:app --port 8000 --reload",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@web3icons/react": "^4.1.21"
  }
}
