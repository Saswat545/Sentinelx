{
  "name": "rugguard-ml",
  "version": "2.0.0",
  "private": true,
  "description": "RugGuard AI - Machine Learning Risk Intelligence Engine & Frontend",
  "scripts": {
    "backend": "python -m uvicorn backend.main:app --port 8000 --reload",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
